# --- Telegram ---
# Token dari @BotFather
TELEGRAM_BOT_TOKEN=
# ID kanal tujuan, contoh: @infolomba_smp  atau  -1001234567890
TELEGRAM_CHANNEL_ID=
# ID Telegram admin (yang menerima draft untuk direview), pisahkan dengan koma
TELEGRAM_ADMIN_IDS=
# Opsional: routing ke Topics (forum) kanal. JSON: {"akademik": 12, "non-akademik": 34}
TELEGRAM_TOPIC_MAP=

# --- LLM ---
# Kompatibel dengan API OpenAI (OpenAI, Gemini OpenAI-compat, OpenRouter, dll)
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.0-flash
LLM_VISION_MODEL=gemini-2.0-flash

# --- Storage ---
DB_PATH=data/infolomba.db
MEDIA_DIR=data/media
